# Cloudflare Workers static-assets security headers (served by the assets layer;
# responses generated by worker.js, e.g. /api/webhooks/whop, do not pass through this file).
#
# CSP is built only from what this project actually loads:
# - its own JS/CSS/images (self);
# - Fontshare + Google Fonts for type;
# - Whop's hosted checkout (embedded as an iframe from whop.com).
# No other third party is allowed. No unsafe-eval.
#
# style-src keeps 'unsafe-inline' because main.js sets element.style
# directly in several places (accordion heights, the Personalización
# scroll transform, modal open/close, --nav-h/--cta-bar-h custom
# properties). Removing it would mean rewriting those to toggle
# pre-defined CSS classes instead — a real refactor, not a header
# change — so it stays as a documented, scoped exception.
#
# font-src includes both api.fontshare.com (serves the @font-face CSS)
# and cdn.fontshare.com (serves the actual .woff2/.woff/.ttf files the
# CSS points to) — confirmed via a live deploy; the CSS-only domain
# alone silently blocks every font file.
#
# Checkout: the widget used to be Whop's "Elements" JS
# (js.whop.cloud), mounted directly on our own origin — Apple Pay
# worked there once our domain was verified with Apple, but Google Pay
# never showed, because Google Pay approval is scoped to whop.com
# itself, not to our origin, and there's no self-service way to add a
# third-party origin to it. Switching the modal to embed Whop's own
# hosted checkout (https://whop.com/checkout/...) in an iframe means
# the wallet buttons run on the origin that's already approved for
# both, so no script-src/connect-src exception for Whop is needed
# anymore — only frame-src (to embed the iframe) and Permissions-Policy
# (to let that iframe use the Payment Request API for Apple/Google Pay).
#
# Meta Pixel: the bootstrap script lives in lib/meta-pixel.js (same-origin,
# no CSP exception needed to load it) but it dynamically injects
# https://connect.facebook.net/en_US/fbevents.js — that needs its own
# script-src entry. Once loaded, fbq() reports events to
# https://www.facebook.com/tr via fetch/beacon (connect-src) and the
# <noscript> fallback hits the same URL as a plain <img> (img-src).
#
# IMPORTANT: test the "Comprar ahora" checkout flow once this is live.
# If it fails silently, open devtools → Console for a CSP violation
# naming the blocked domain/directive and add only that.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://whop.com")
  Content-Security-Policy: default-src 'self'; script-src 'self' https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://api.fontshare.com https://cdn.fontshare.com; img-src 'self' data: https://www.facebook.com; frame-src https://whop.com; connect-src 'self' https://www.facebook.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML: always revalidate so a deploy is never masked by a stale cached page.
/*.html
  Cache-Control: no-cache, must-revalidate

# JS/CSS/JSON: revalidate every visit (cache-busted via ?v= query anyway).
/*.js
  Cache-Control: no-cache, must-revalidate
/*.css
  Cache-Control: no-cache, must-revalidate
/*.json
  Cache-Control: no-cache, must-revalidate

# Images and fonts: long cache, they change rarely and aren't cache-busted.
/assets/*
  Cache-Control: public, max-age=2592000
